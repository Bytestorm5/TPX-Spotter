{
  "name": "@trusplex/ui",
  "version": "0.1.0",
  "description": "The Trusplex component kit: the Spotter widget's design system — contrast-checked theme tokens, one stylesheet, and accessible React components — for any app.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "source": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./css": {
      "source": "./src/css.ts",
      "types": "./dist/css.d.ts",
      "default": "./dist/css.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "node scripts/emit-css.mjs && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gallery": "node scripts/gallery.mjs"
  }
}
